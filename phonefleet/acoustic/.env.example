# Connexion SSH vers le Fairphone (Termux:API requis sur le téléphone)
# Utilisée UNIQUEMENT pour le post-traitement PC (collecte/dashboard) — pas pour
# le fonctionnement autonome en mer.
#
# PHONE_HOST = identifiant stable indépendant du DHCP (recommandé) :
#   - nom Tailscale       : fairphone   (ou fairphone.<tailnet>.ts.net) — marche
#                           même sur un autre réseau / 4G, idéal au retour au port
#   - nom mDNS/Bonjour    : fairphone.local — sur le même Wi-Fi (paquet avahi)

PHONE_HOST=fairphone
PHONE_IP=
SSH_PORT=8022
SSH_USER=
SSH_PASSWORD=

# Site de déploiement : sete, banyuls, marseille, montpellier, ... (ou "autre")
# Laisser vide pour le saisir interactivement au lancement (python -m pc.launch)
SITE=

# Capteur piézo / hydrophone (référence + numéro de série)
# Laisser vide pour le saisir interactivement au lancement
PIEZO_MODEL=
PIEZO_SERIAL=

# Dossier local de stockage des enregistrements
OUTPUT_FOLDER=recordings

# Profil de déploiement (point 4) : SIMPLE | ALERTE | ALLO_BRUIT | TOUTES_OPTIONS
# Généralement défini par le script wrapper Termux, pas ici. Sert de valeur par
# défaut si aucun wrapper n'exporte PROFILE.
PROFILE=TOUTES_OPTIONS

# Surcharge fine des options (laisser vide = valeur du profil ci-dessus).
# Valeurs vraies : 1/true/yes/oui/on.
# ENABLE_SMS_DETECTION=   # SMS sur toutes les classes d'alerte {petit/moyen/grand bateau, poisson}
# ENABLE_SMS_BATTERY=     # SMS batterie faible
# ENABLE_BIO_DEDICATED=   # traitement dédié poisson : seuil BIO_MIN_CONFIDENCE + notif [ALLO BRUIT]
# ENABLE_GPS=
# ENABLE_DASHBOARD=       # écrit deployment_status.txt (autonomie) à chaque cycle

# Alertes SMS
ALERT_PHONE=+33XXXXXXXXX
MIN_CONFIDENCE=0.65
# Seuil de la classe biologique/poisson quand le traitement dédié est actif
# (profils ALLO_BRUIT/TOUTES_OPTIONS). Défaut = MIN_CONFIDENCE.
BIO_MIN_CONFIDENCE=0.55
COOLDOWN_MINUTES=10

# Modèle IA (laisser vide = poids aléatoires non entraînés)
MODEL_WEIGHTS=

# Paramètres d'enregistrement(en secondes)
RECORD_DURATION=6
SLEEP_DURATION=3
SAMPLE_RATE=44100

# Seuils
BATTERY_VOLTAGE_THRESHOLD_MV=3400

# Autonomie batterie (point 3) : consommation calibrée de départ, en % / jour.
# Mesurable par un test réel (voir GUIDE.md). L'estimation bascule ensuite sur le
# taux de décharge réellement observé pendant la mission.
BATTERY_DRAIN_PCT_PER_DAY=25
